# ~/.bashrc — managed by chezmoi (bash on Linux + git bash)

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# --- History ---
HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend

# --- Shell behaviour ---
shopt -s checkwinsize
shopt -s globstar 2>/dev/null

# --- Completion ---
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# --- Prompt: starship if installed, otherwise a colored fallback ---
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
else
  if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
      debian_chroot=$(cat /etc/debian_chroot)
  fi

  case "$TERM" in
      xterm-color|*-256color) color_prompt=yes;;
  esac

  if [ "$color_prompt" = yes ]; then
      PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
  else
      PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
  fi
  unset color_prompt

  case "$TERM" in
  xterm*|rxvt*)
      PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
      ;;
  esac
fi

# --- fzf key bindings: Ctrl-R history, Ctrl-T file search, Alt-C cd ---
command -v fzf >/dev/null 2>&1 && eval "$(fzf --bash)"

# --- Shared shell config (env, aliases, functions) ---
{{- if eq .chezmoi.os "windows" }}
# git bash takes only the env layer and the local escape hatch: aliases.sh and
# functions.sh are Linux-only (apt, snap, flatpak, wg-quick, pw-loopback,
# dockerised dep). The portable ones are redefined at the bottom of this file.
for f in ~/.config/shell/{exports,local}.sh; do
{{- else }}
for f in ~/.config/shell/{exports,aliases,functions,local}.sh; do
{{- end }}
  [ -r "$f" ] && . "$f"
done
{{ if eq .chezmoi.os "windows" }}
# --- Windows replacements for the shared aliases ---
alias ls="eza"
alias l="ls --icons=always --color=always --color-scale=size --classify=always --show-symlinks --group --header --time-style=long-iso"
alias vim="nvim"
# choco upgrade needs an elevated shell; run git bash as Administrator
alias update="choco upgrade all -y && uv tool upgrade ha-mcp && claude update"
{{ end }}
# --- bash-only alias overrides ---
alias gaa="git add -A"
alias gst="git status"
alias gcmsg="git commit -m"
alias gp="git push"
alias gss="git status --short"
alias gd="git diff"

. "$HOME/.local/share/../bin/env"

# --- zoxide: frecency-based cd (z, zi) ---
# Must come last: its hook appends to PROMPT_COMMAND, which starship also sets.
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"
