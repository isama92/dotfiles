# Identity comes from the machine-local chezmoi config, not from this repo.
# `chezmoi init` prompts for both and stores them in
# ~/.config/chezmoi/chezmoi.toml (never committed). See README.md.
[user]
	name = Stefano Borzoni
	email = {{ .git.email }}
	signingkey = {{ .git.signingkey }}
[delta]
    navigate = true  # use n and N to move between diff sections
    light = true      # or `dark = true`, or omit for auto-detection
    side-by-side = true
    line-numbers = true
    syntax-theme = Catppuccin Latte
    true-color = always
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[interactive]
    diffFilter = delta --color-only
[pull]
    rebase = false
[push]
	default = current
	autoSetupRemote = true
[merge]
    conflictStyle = zdiff3
[core]
    pager = delta
	excludesfile = ~/.gitignore
{{- if eq .chezmoi.os "windows" }}
    # Git for Windows bundles an MSYS2 ssh that cannot reach the named pipe
    # \\.\pipe\openssh-ssh-agent, where 1Password serves its agent. Point git
    # at the native OpenSSH client instead; see ~/.ssh/config for the same story.
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- end }}
[safe]
	directory = /var/www/html
{{- if eq .chezmoi.os "windows" }}
[gpg]
    # gpg only sits on PATH inside Git Bash; spell out the path so signing also
    # works from PowerShell, editors, and GUI clients.
    program = "C:/Program Files/Git/usr/bin/gpg.exe"
{{- end }}

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[tag]
	gpgsign = true
